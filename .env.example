# Copia este archivo a .env. Las variables VITE_* quedan visibles en el navegador:
# nunca pongas secretos aquí.

# URL base de la API (turnos-api)
VITE_API_URL=http://localhost:3000/api/v1

# Nombre que se muestra en el título y la barra superior
VITE_APP_NAME=Turnos y Citas

# Formato de fechas y zona horaria del colegio (las horas se muestran en esta zona)
VITE_LOCALE=es-BO
VITE_TIMEZONE=America/La_Paz

# Cada cuántos segundos se actualiza sola la agenda del día (mínimo 5)
VITE_POLL_SECONDS=15
